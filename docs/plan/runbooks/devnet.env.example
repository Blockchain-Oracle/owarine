# DevNet env for the one-off scripts (devnet-preflight, bootstrap-devnet). Copy to ~/.config/owarine/canton/devnet.env
# (outside the repo), `chmod 600` it, and fill the two empty lines. The other values are the public ones from the
# HackCanton materials (context: 00-hackathon/s3-devnet-sandbox.md). The same names go into Coolify for pm-web and
# pm-ops (K-035 option A). Never commit the filled copy; never paste it into a chat.
LEDGER_JSON_API_URL=https://ledger-api-json.participant.hackcanton-01.devnet.naas.noders.services
LEDGER_AUTH_MODE=password
LEDGER_OIDC_TOKEN_URL=https://keycloak.naas.noders.services/realms/noders-appsfactory/protocol/openid-connect/token
LEDGER_OIDC_CLIENT_ID=web-app-ui-hackcanton-01-devnet
LEDGER_OIDC_AUDIENCE=https://hackcanton-01.devnet.naas.noders.services
LEDGER_OIDC_USERNAME=
LEDGER_OIDC_PASSWORD=
