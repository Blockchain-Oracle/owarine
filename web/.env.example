# Web app environment: NAMES ONLY. Copy to web/.env.local locally; on Coolify set each in the web app's Environment
# Variables (runbook: docs/plan/runbooks/coolify-deploy.md). Never put a credential in a NEXT_PUBLIC_* name: those are
# inlined into the browser bundle at build time, so on Coolify they must be marked "Build Variable".
# Defaults are in the comments; an unset optional variable uses its default.

# --- Required in production (the boot check in src/instrumentation-node.ts refuses to start without them) ---------
DATABASE_URL=                       # Postgres (Coolify-managed); the projection, seat pool, journal
AGARI_SEAT_COOKIE_SECRET=           # >= 32 chars, random; signs the seat cookie
OPS_INTERNAL_URL=                   # ops' HTTP as the web reaches it, e.g. the ops container's internal URL on :8080
OPS_INTERNAL_SECRET=                # >= 32 chars; the same value in ops (HMAC on /internal/*)
AGARI_PARTIES_FILE=                 # path to the bootstrap's parties.json (a Coolify file mount, e.g. /data/parties.json)
# ...or name the parties directly instead of (or on top of) the file:
# AGARI_VENUE_PARTY=
# AGARI_SEAT_PARTIES=               # comma-separated seat parties (the lease pool)
# AGARI_PERSONA_ALICE=
# AGARI_PERSONA_BOB=
# AGARI_PERSONA_OUTSIDER=
# AGARI_AGENT_RUNNER_PARTY=

# --- Ledger (packages/ledger; the browser never sees any of these) --------------------------------------------------
LEDGER_JSON_API_URL=                # local sandbox http://127.0.0.1:7575 · Noders DevNet: the participant's JSON API host
LEDGER_AUTH_MODE=                   # none (local sandbox) | password (Noders, K-035)
# LEDGER_USER_ID=                   # mode none; default agari-local
# LEDGER_OIDC_TOKEN_URL=            # mode password
# LEDGER_OIDC_CLIENT_ID=
# LEDGER_OIDC_USERNAME=
# LEDGER_OIDC_PASSWORD=
# LEDGER_OIDC_SCOPE=                # default "openid daml_ledger_api"
# LEDGER_OIDC_AUDIENCE=
# LEDGER_REQUEST_TIMEOUT_MS=        # default 30000
# LEDGER_SUBMIT_TIMEOUT_MS=         # default 60000
# LEDGER_MAX_ATTEMPTS=              # default 4

# --- Hosting behind Coolify's Traefik (K-003) -------------------------------------------------------------------------
TRUSTED_PROXY=                      # forwarded on Coolify (the web Dockerfile's default); unset = trust no header
# AGARI_GEOIP_DB=                   # default data/geo/dbip-country-lite.csv.gz (fetched by scripts/geo/fetch-dbip.mjs)
# AGARI_REGION_OVERRIDE=            # a country code (e.g. US) forces the region hold for testing
# AGARI_INDEXER_INTERNAL_URL=       # server-side projection reads; default this process over loopback

# --- Public, inlined at build ("Build Variable" on Coolify) ---------------------------------------------------------
NEXT_PUBLIC_APP_ORIGIN=             # https://<domain>
NEXT_PUBLIC_SITE_URL=               # https://<domain>
NEXT_PUBLIC_DOCS_URL=               # https://docs.<domain>
NEXT_PUBLIC_PRICE_FEED_URL=         # ops' public SSE origin, https://ops.<domain>
NEXT_PUBLIC_LADDER_URL=             # ops' venue ladder SSE, https://ops.<domain>
# NEXT_PUBLIC_AGARI_INDEXER_URL=    # default /api/index (same origin)
# NEXT_PUBLIC_CANTON_NETWORK=       # devnet (default) | localnet | testnet | mainnet
# NEXT_PUBLIC_LEDGER_API_PATH=      # default /api/ledger
# NEXT_PUBLIC_DAML_PACKAGE_NAME=    # default abu-pm-main
# NEXT_PUBLIC_AGARI_VENUE_ID=
# NEXT_PUBLIC_X_HANDLE=
# NEXT_PUBLIC_X_EXECUTOR_PARTY=

# --- Duel room, push, X, AI (optional features; each answers "not live" without its variables) ---------------------
# ROOM_TOKEN_SECRET=                # >= 16 chars; the same value in ops
# GAME_ROOM_PUBLIC_URL=             # wss://room.<domain>
# PUSH_DRAIN_SECRET=                # the same value in ops
# EXPO_ACCESS_TOKEN=
# X_API_KEY=
# X_API_KEY_SECRET=
# X_REDIRECT_URI=                   # https://<domain>/api/x/callback
# X_SESSION_SECRET=
# X_EXECUTOR_PARTY=
# FINNHUB_API_KEY=                  # news wire and earnings
# AI_MODEL=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_GATEWAY_API_KEY=
# AI_BASE_URL=
# AI_API_KEY=

# --- Seats, seasons, board (optional tuning) -------------------------------------------------------------------------
# AGARI_SEAT_IDLE_TTL_SEC=          # default 900
# AGARI_SEAT_HARD_CAP_SEC=          # default 14400
# AGARI_ALLOW_SEATLESS=             # 1 = boot without seats (docs-only or read-only host)
# PROJECTOR_STREAM=                 # default venue; must match ops
# SEASON_ID=
# SEASON_NAME=
# SEASON_ENDS_AT=
# SEASON_PRIZE_SPLIT=
# SEASON_MIN_STAKED_DUELS=
# SEASON_ELIGIBILITY_NOTE=
# AGARI_OPERATOR_WALLETS=
