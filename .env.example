# Root environment: NAMES ONLY. Copy to .env.local; never commit values. Read by scripts/ (bootstrap, drives, probes,
# price archivers) and, after services/ops/.env.local, by ops. web/.env.example and services/ops/.env.example list
# each app's own variables. `pnpm env:check` shows what is set, never the values.

# Price sources (server only)
PYTH_API_KEY=
ALPACA_ENDPOINT=
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
FINNHUB_API_KEY=
# JUPITER_API_KEY=

# Ledger and parties for the bootstrap and drive scripts (local sandbox by default)
# LEDGER_JSON_API_URL=
# LEDGER_AUTH_MODE=                 # none (local) | password (DevNet: bootstrap-devnet.ts, devnet-preflight.ts)
# OWARINE_PARTIES_FILE=               # DevNet: ~/.config/owarine/canton/parties.devnet.json (outside the repo)
# DevNet credential names (mode password). Prefer exporting them in the shell for one run over keeping them here.
# LEDGER_OIDC_TOKEN_URL=
# LEDGER_OIDC_CLIENT_ID=
# LEDGER_OIDC_USERNAME=
# LEDGER_OIDC_PASSWORD=
# LEDGER_OIDC_SCOPE=
# LEDGER_OIDC_AUDIENCE=
# DATABASE_URL=

# Season admin (scripts/season-admin.ts, C4d L4): ops' internal URL and the admin's own secret (the value pm-ops holds as
# OPS_ADMIN_SECRET; never the web's OPS_INTERNAL_SECRET)
# OPS_INTERNAL_URL=
# OPS_ADMIN_SECRET=
