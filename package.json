{
  "name": "owarine",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm -r typecheck",
    "test": "node --test scripts/lib/evidence-ref.test.mjs && vitest run",
    "invariants": "node scripts/invariants/run.mjs",
    "ci": "pnpm typecheck && pnpm invariants && pnpm test",
    "env:check": "node scripts/env-check.mjs",
    "codegen:daml": "node packages/daml-clients/scripts/codegen.mjs",
    "archive:pyth": "node --env-file-if-exists=.env.local scripts/archive/pyth-trial.mjs --follow",
    "archive:redstone": "node --env-file-if-exists=.env.local scripts/archive/redstone.mjs --follow",
    "archive:start": "bash scripts/archive/start.sh",
    "ops:start": "pnpm --filter @owarine/ops start",
    "devnet:preflight": "pnpm --filter @owarine/scripts exec tsx --env-file-if-exists=$HOME/.config/owarine/canton/devnet.env devnet-preflight.ts",
    "devnet:bootstrap": "pnpm --filter @owarine/scripts exec tsx --env-file-if-exists=$HOME/.config/owarine/canton/devnet.env bootstrap-devnet.ts"
  },
  "devDependencies": {
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
