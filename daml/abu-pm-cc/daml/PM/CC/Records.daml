-- | The Canton Coin rail's records (C7b): the per-owner redeemable allowance, the
-- deposit and withdrawal receipts, the reserve statement, and the helpers they share.
--
--   CcAllowance         venue-signed, owner and auditor observers: the cash units
--                       the venue owes this owner back IN COIN, at the terms (listing
--                       id, instrument, rate) they were deposited under. A deposit
--                       raises it, a withdrawal lowers it, a refunded withdrawal
--                       restores it. Winnings and demo credits never raise it: coin
--                       out never exceeds coin in, per owner.
--   CcDeposit           the receipt of one settled deposit. Its `ensure` pins the
--                       credit to the coin received: received == units * atomicPerUnit.
--   CcWithdrawal        the receipt of one withdrawal: Sent (a TransferInstruction is
--                       in flight to the owner), Completed, or Refunded. A Sent one ends
--                       by the owner accepting it (bookkeeping: `Withdrawal_Complete`), by
--                       the venue taking it back (`Withdrawal_Refund`) or by the owner
--                       rejecting it through the receipt (`Withdrawal_OwnerReject`). A
--                       transfer the owner rejects OUTSIDE the receipt (a wallet) leaves
--                       the receipt Sent: nothing on the ledger can show the venue that
--                       coin came back, so nothing refunds it on the venue's word alone.
--   CcReserveStatement  the venue's unlocked holdings against the allowances it names.
--
-- Every allowance and every owner-signed proposal carries the TERMS it was made under
-- (listing id, instrument admin and id, rate), and every choice that spends or counts
-- one checks them against the listing. A listing is a venue-signed contract the venue
-- can archive and re-create, so the terms cannot live only there.
module PM.CC.Records where

import DA.List (unique)
import DA.Optional (isNone, isSome)
import PM.CC.Units
import PM.Money
import PM.Types
import Splice.Api.Token.HoldingV1 qualified as H
import Splice.Api.Token.MetadataV1 (ExtraArgs)
import Splice.Api.Token.TransferInstructionV1 qualified as T

-- | The transfer metadata key a deposit or a withdrawal carries its reference in.
refMetaKey : Text
refMetaKey = "abu-pm.io/ref"

-- | The `VenueCash.bucket` a deposit is credited into.
ccBucket : Text -> Text
ccBucket listingId = "cc:" <> listingId

-- | The bucket a refunded withdrawal is credited back into.
refundBucket : Text -> Text
refundBucket listingId = "cc-refund:" <> listingId

-- | What a listing states and an allowance or a request is made under.
data Terms = Terms with
    listingId : Text
    instrumentAdmin : Party
    instrumentId : Text
    unitsPerCoin : Int
  deriving (Eq, Show)

-- ---------------------------------------------------------------------------
-- Allowance

template CcAllowance
  with
    venue : Party
    auditor : Party
    owner : Party
    listingId : Text
    instrumentAdmin : Party
    instrumentId : Text
    unitsPerCoin : Int
    units : Int
      -- ^ cash units redeemable for coin at `unitsPerCoin`
  where
    signatory venue
    observer owner, auditor
    ensure rateOk unitsPerCoin && units > 0 && units <= maxTotalUnits / atomicPerUnit unitsPerCoin
      && listingId /= "" && instrumentId /= ""
      && venue /= owner && venue /= auditor && owner /= auditor

    -- Fold duplicates of the same owner's allowance under the same terms into this one.
    choice Allowance_Merge : ContractId CcAllowance
      with
        others : [ContractId CcAllowance]
      controller venue
      do
        require "no-others" "nothing to merge" (not (null others))
        require "duplicate-allowance" "the same allowance was named twice" (unique others)
        parts <- forA others \c -> do
          a <- fetch c
          require "foreign-allowance" "an allowance is another owner's or under other terms"
            (a.venue == venue && a.owner == owner && allowanceTerms a == allowanceTerms this)
          archive c
          pure a.units
        total <- case sumWithin (maxTotalUnits / atomicPerUnit unitsPerCoin) (units :: parts) of
          Some t -> pure t
          None -> refuse "allowance-overflow" "the merged allowance would pass its bound"
        create this with units = total

allowanceTerms : CcAllowance -> Terms
allowanceTerms a = Terms with listingId = a.listingId; instrumentAdmin = a.instrumentAdmin; instrumentId = a.instrumentId; unitsPerCoin = a.unitsPerCoin

-- | Raise the owner's allowance by `add`: consume the live one (if the venue names
-- it) and create the sum. Refuses another owner's, one under other terms, or an overflow.
raiseAllowance : Party -> Party -> Party -> Terms -> Optional (ContractId CcAllowance) -> Int -> Update (ContractId CcAllowance)
raiseAllowance venue auditor owner terms existing add = do
  base <- case existing of
    None -> pure 0
    Some cid -> do
      a <- fetch cid
      require "foreign-allowance" "the allowance is another owner's or under other terms"
        (a.venue == venue && a.owner == owner && allowanceTerms a == terms)
      archive cid
      pure a.units
  total <- case sumWithin (maxTotalUnits / atomicPerUnit terms.unitsPerCoin) [base, add] of
    Some t -> pure t
    None -> refuse "allowance-overflow" "the allowance would pass its bound"
  create CcAllowance with
    venue; auditor; owner; listingId = terms.listingId; instrumentAdmin = terms.instrumentAdmin
    instrumentId = terms.instrumentId; unitsPerCoin = terms.unitsPerCoin; units = total

-- | Lower the owner's allowance by `take`; refused when it is not covered or is under
-- other terms. Returns what is left, if anything.
lowerAllowance : Party -> Party -> Terms -> ContractId CcAllowance -> Int -> Update (Optional (ContractId CcAllowance))
lowerAllowance venue owner terms cid take = do
  a <- fetch cid
  require "foreign-allowance" "the allowance is another owner's or under other terms"
    (a.venue == venue && a.owner == owner && allowanceTerms a == terms)
  require "over-allowance" "the withdrawal is more than this owner has deposited and not taken back" (take <= a.units)
  archive cid
  if a.units == take then pure None else Some <$> create a with units = a.units - take

-- ---------------------------------------------------------------------------
-- Holdings

-- | The atomic total of holdings of one instrument, fetched through the CIP-56
-- Holding interface. Every holding must be the given owner's and of the given
-- instrument, none may be named twice, and none may carry more than `maxCoins` whole
-- coin. With `unlockedOnly` a locked holding is refused (a deposit's receiver holdings
-- are never locked). The sum is taken where it cannot overflow.
holdingsAtomic : Party -> Party -> Text -> Bool -> Int -> [ContractId H.Holding] -> Update Int
holdingsAtomic owner admin instrument unlockedOnly maxCoins cids = do
  require "duplicate-holding" "the same holding was named twice" (unique cids)
  parts <- forA cids \cid -> do
    h <- fetch cid
    let v = view h
    require "foreign-holding" "a holding is not the expected owner's, or is of another instrument"
      (v.owner == owner && v.instrumentId.admin == admin && v.instrumentId.id == instrument)
    require "locked-holding" "a locked holding cannot be counted here" (not unlockedOnly || isNone v.lock)
    case toAtomicUpTo maxCoins v.amount of
      Some a -> pure a
      None -> refuse "bad-holding-amount" "a holding's amount is zero or above the rail's bound"
  case sumWithin maxTotalUnits parts of
    Some total -> pure total
    None -> refuse "holdings-overflow" "the holdings pass the rail's bound"

-- ---------------------------------------------------------------------------
-- Receipts

template CcDeposit
  with
    venue : Party
    owner : Party
    auditor : Party
    listingId : Text
    instrumentAdmin : Party
    instrumentId : Text
    unitsPerCoin : Int
    receivedAtomic : Int
    units : Int
    settledAt : Time
    ref : Text
  where
    signatory venue
    observer owner, auditor
    ensure rateOk unitsPerCoin && cashUnitsOk unitsPerCoin units
      && receivedAtomic == atomicOfUnits unitsPerCoin units

data WithdrawalState = WdSent | WdCompleted | WdRefunded
  deriving (Eq, Show)

template CcWithdrawal
  with
    venue : Party
    owner : Party
    auditor : Party
    listingId : Text
    instrumentAdmin : Party
    instrumentId : Text
    unitsPerCoin : Int
    units : Int
    sentAtomic : Int
    state : WithdrawalState
    instructionCid : Optional (ContractId T.TransferInstruction)
    openedAt : Time
    ref : Text
  where
    signatory venue
    observer owner, auditor
    ensure rateOk unitsPerCoin && cashUnitsOk unitsPerCoin units
      && sentAtomic == atomicOfUnits unitsPerCoin units
      && (state == WdSent) == isSome instructionCid

    -- Bookkeeping: the venue records that the transfer has been accepted. The ledger
    -- cannot see that (an archived instruction is invisible to Daml), so this is the
    -- venue's word; what it cannot do is hurt the owner, who can still accept a
    -- transfer that is pending, and cannot reject one through `Withdrawal_OwnerReject`
    -- once this has run (the owner accepts, or takes the coin, instead).
    choice Withdrawal_Complete : ContractId CcWithdrawal
      controller venue
      do
        require "not-sent" "only a withdrawal in flight can complete" (state == WdSent)
        create this with state = WdCompleted; instructionCid = None

    -- Take an in-flight transfer back (the owner never accepted it): the registry
    -- must answer `Failed` and hand back the coin, then the cash and the allowance
    -- are restored, in this one transaction.
    choice Withdrawal_Refund : (ContractId CcWithdrawal, ContractId VenueCash, ContractId CcAllowance)
      with
        accountCid : ContractId VenueAccount
        allowanceCid : Optional (ContractId CcAllowance)
        extraArgs : ExtraArgs
      controller venue
      do
        require "not-sent" "only a withdrawal in flight can be refunded" (state == WdSent)
        instr <- case instructionCid of
          Some c -> pure c
          None -> refuse "not-sent" "the withdrawal has no transfer in flight"
        res <- exercise instr T.TransferInstruction_Withdraw with extraArgs
        case res.output of
          T.TransferInstructionResult_Failed -> pure ()
          _ -> refuse "withdraw-not-failed" "the registry did not take the transfer back"
        back <- holdingsAtomic venue instrumentAdmin instrumentId True maxHoldingCoins res.senderChangeCids
        require "not-returned" "the registry did not hand back the coin that was sent" (back >= sentAtomic)
        restoreWithdrawal this accountCid allowanceCid

    -- The owner rejects the transfer themselves: they exercise the token standard's
    -- own `TransferInstruction_Reject` (the receiver's choice), the registry must answer
    -- `Failed` and hand the coin back to the venue, and the cash and the allowance are
    -- restored in the same transaction, on the owner's word and the ledger's check, not
    -- the venue's. This is how an owner who does not want a transfer gets their cash back.
    choice Withdrawal_OwnerReject : (ContractId CcWithdrawal, ContractId VenueCash, ContractId CcAllowance)
      with
        accountCid : ContractId VenueAccount
        allowanceCid : Optional (ContractId CcAllowance)
        extraArgs : ExtraArgs
      controller owner
      do
        require "not-sent" "only a withdrawal in flight can be rejected" (state == WdSent)
        instr <- case instructionCid of
          Some c -> pure c
          None -> refuse "not-sent" "the withdrawal has no transfer in flight"
        res <- exercise instr T.TransferInstruction_Reject with extraArgs
        case res.output of
          T.TransferInstructionResult_Failed -> pure ()
          _ -> refuse "reject-not-failed" "the registry did not take the transfer back"
        back <- holdingsAtomic venue instrumentAdmin instrumentId True maxHoldingCoins res.senderChangeCids
        require "not-returned" "the registry did not hand back the coin that was sent" (back >= sentAtomic)
        restoreWithdrawal this accountCid allowanceCid

-- | The shared tail of every refund: credit the cash back, restore the allowance, and
-- record the receipt as Refunded. Runs inside the choice that consumed the receipt.
restoreWithdrawal : CcWithdrawal -> ContractId VenueAccount -> Optional (ContractId CcAllowance) -> Update (ContractId CcWithdrawal, ContractId VenueCash, ContractId CcAllowance)
restoreWithdrawal w accountCid allowanceCid = do
  acct <- fetch accountCid
  require "wrong-account" "the account is not the owner's" (acct.venue == w.venue && acct.owner == w.owner)
  cash <- exercise accountCid VenueAccount_Credit with amount = w.units; bucket = refundBucket w.listingId
  allowance <- raiseAllowance w.venue w.auditor w.owner (Terms with listingId = w.listingId; instrumentAdmin = w.instrumentAdmin; instrumentId = w.instrumentId; unitsPerCoin = w.unitsPerCoin) allowanceCid w.units
  receipt <- create w with state = WdRefunded; instructionCid = None
  pure (receipt, cash, allowance)

-- ---------------------------------------------------------------------------
-- Reserve statement

template CcReserveStatement
  with
    venue : Party
    auditor : Party
    listingId : Text
    instrumentAdmin : Party
    instrumentId : Text
    unitsPerCoin : Int
    seq : Int
    asOf : Time
    heldAtomic : Int
      -- ^ atomic units in the unlocked holdings the venue named
    heldUnits : Int
      -- ^ heldAtomic in this listing's cash units, rounded DOWN
    liabilityAtomic : Int
      -- ^ what the allowances the venue named come to, in atomic units, each at its own rate
    liabilityUnits : Int
      -- ^ liabilityAtomic in this listing's cash units, rounded UP
    allowanceCount : Int
    covered : Bool
  where
    signatory venue
    observer auditor
    ensure rateOk unitsPerCoin && seq >= 0 && allowanceCount >= 0
      && heldAtomic >= 0 && heldAtomic <= maxTotalUnits && liabilityAtomic >= 0 && liabilityAtomic <= maxTotalUnits
      && heldUnits == unitsFloor unitsPerCoin heldAtomic
      && liabilityUnits == unitsCeil unitsPerCoin liabilityAtomic
      && covered == (heldAtomic >= liabilityAtomic)
