-- | A governed resolution settles Legs exactly as the plain resolver path
-- does. Two windows of one series carry the same trade (Alice on the
-- governed one, Bob on the plain one) and the same prints; one is decided
-- by a committee vote, the other by the single-key resolver command the
-- product used before governance (possible here only because Daml Script
-- has no topology: a Decentralized Party could not submit it). The users'
-- payouts, the venue's cash and fee, and the Resolution's content match.
-- Then the same for a void, and a governed event.
module Test.Governance.Parity where

import Daml.Script
import DA.Assert ((===))
import DA.Foldable (forA_)
import PM.Event
import PM.Governance.Resolve
import PM.Leg
import PM.Market
import PM.Money
import PM.Types
import Test.Event (attest, mkEvent)
import Test.Governance.Fixture
import Test.Governance.Resolve (closeProposal, govOpen, propose)
import Test.Setup

px : Int
px = 6500000000000

venueCash : Gov -> Text -> Script Int
venueCash g bucket = do
  vc <- query @VenueCash g.w.venue
  pure (sum [c.amount | (_, c) <- vc, c.owner == g.w.venue, c.bucket == bucket])

-- | What a Resolution says, without its ids (terms, market, quote cids).
data Content = Content
  with
    outcome : Optional Side
    voidReason : Optional VoidReason
    openPriceE8 : Optional Int
    closePriceE8 : Optional Int
    signers : Int
    openPrices : [Int]
    closePrices : [Int]
  deriving (Eq, Show)

content : Resolution -> Content
content r = Content with
  outcome = r.outcome; voidReason = r.voidReason; openPriceE8 = r.openPriceE8
  closePriceE8 = r.closePriceE8; signers = r.signers
  openPrices = map (.priceE8) r.openEvidence; closePrices = map (.priceE8) r.closeEvidence

settleAll : Gov -> [ContractId Leg] -> ContractId Resolution -> Script ()
settleAll g legs res = forA_ legs \l -> submit g.w.venue do exerciseCmd l Leg_Settle with resolutionCid = res

oneResolution : Gov -> ContractId MarketTerms -> Script (ContractId Resolution, Resolution)
oneResolution g terms = do
  rs <- query @Resolution g.w.venue
  case [(c, r) | (c, r) <- rs, r.termsCid == terms] of
    [x] -> pure x
    _ -> abort "expected one resolution"

testGovernedSettlesLikePlain = script do
  (g, s1, w0, ar) <- mkGovWin
  let w = g.w
  (s2, w1) <- openWin w s1 1
  (s3, w2) <- openWin w s2 2
  (_, w3) <- openWin w s3 3
  -- window 0, governed: Alice buys Up 620 x 10, fee 37; the close is higher
  op0 <- govOpen g w0 ar px
  (a0, v0) <- trade w w0 w.alice SideUp 620 10 37 "g0"
  fee0 <- venueCash g "fee"
  p <- closeProposal g w0 op0 ar (px + 5) (Some SideUp)
  _ <- pass g p
  (res0, r0) <- oneResolution g w0.terms
  settleAll g [a0, v0] res0
  fee1 <- venueCash g "fee"
  -- window 1, plain: Bob, the same trade and prints, the resolver's command
  op1 <- recordOpen w w1 px
  (b1, v1) <- trade w w1 w.bob SideUp 620 10 37 "p1"
  res1 <- resolveAt w w1 op1 (px + 5)
  Some r1 <- queryContractId w.venue res1
  settleAll g [b1, v1] res1
  fee2 <- venueCash g "fee"
  content r0 === content r1
  cashOf w.alice >>= (=== 10000)
  cashOf w.bob >>= (=== 10000)
  fee1 - fee0 === 37
  fee2 - fee1 === 37
  -- a void: window 2 by vote, window 3 by the resolver; both refund 6200 + 37
  aliceBefore <- cashOf w.alice
  bobBefore <- cashOf w.bob
  op2 <- govOpen g w2 ar px
  (a2, v2) <- trade w w2 w.alice SideUp 620 10 37 "g2"
  op3 <- recordOpen w w3 px
  (b3, v3) <- trade w w3 w.bob SideUp 620 10 37 "p3"
  at (plus w2.t.closeDeadline 1)
  pv <- propose g w.venue w2.t.marketId
    (VoidPrice with termsCid = w2.terms; stage = AfterOpen op2; quoteCids = []) "no close print"
  _ <- pass g pv
  (res2, r2) <- oneResolution g w2.terms
  settleAll g [a2, v2] res2
  res3 <- voidClose w w3 op3
  Some r3 <- queryContractId w.venue res3
  settleAll g [b3, v3] res3
  content r2 === content r3
  r2.voidReason === Some (MissingPrint CloseSlot)
  aliceAfter <- cashOf w.alice
  bobAfter <- cashOf w.bob
  aliceAfter - aliceBefore === 6200 + 37
  bobAfter - bobBefore === 6200 + 37
  venueCash g "fee" >>= (=== fee2)

-- An event is decided only by a vote (never delegated): two YES
-- attestations, the committee confirms YES, Alice's YES leg wins.
testGovernedEvent = script do
  g <- mkGov
  let w = g.w
  ev <- mkEvent w
  let evRules = (genesisRules g) with maxDeviationBps = 0
  ar <- approveRules g "EVT-DEMO-1" evRules
  (aliceYes, venueNo) <- trade w ev.win w.alice SideUp 400 10 3 "evt-g1"
  at (plus ev.e.closeTime 30)
  y1 <- attest w ev w.o1 True 10
  y2 <- attest w ev w.o2 True 20
  p <- propose g g.m1 ev.e.marketId
    (ResolveEvent with
      eventCid = ev.event; eventStateCid = ev.st; attestationCids = [y1, y2]; rulesCid = ar
      expected = Some SideUp)
    "two committee attestations say YES"
  _ <- pass g p
  (res, r) <- oneResolution g ev.win.terms
  r.outcome === Some SideUp
  vs <- query @EventVerdict w.venue
  map (\(_, v) -> v.answer) vs === [Some True]
  settleAll g [aliceYes, venueNo] res
  cashOf w.alice >>= (=== 10000)
