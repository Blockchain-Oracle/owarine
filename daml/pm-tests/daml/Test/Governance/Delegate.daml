-- | The delegate (routine price Windows without a vote each), a guardian's
-- hold, revocation by vote; and who sees the governance internals.
module Test.Governance.Delegate where

import Daml.Script
import DA.Assert ((===))
import DA.Foldable (forA_)
import Governance.Confirmation
import Governance.ExecutionResult
import Governance.Rules
import PM.Governance.Delegate
import PM.Governance.Policy
import PM.Governance.Resolve
import PM.Governance.Rules
import PM.Governance.Venue
import PM.Market
import PM.Types
import Test.Governance.Fixture
import Test.Governance.Resolve (closeProposal, govOpen)
import Test.Setup

px : Int
px = 6500000000000

grantDelegation : Gov -> [Text] -> Script (ContractId ResolverDelegation)
grantDelegation g keys = do
  now <- getTime
  p <- submit g.m1 do
    createCmd DelegationProposal with
      governanceParty = g.gov; proposer = g.m1; venue = g.w.venue
      change = Grant with delegate = g.bot; guardians = [g.m1, g.m2, g.m3]; seriesKeys = keys
      rationale = "routine price windows"; expiresAt = plus now 3600
  _ <- pass g (toInterfaceContractId p)
  ds <- query @ResolverDelegation g.bot
  case ds of
    [(c, _)] -> pure c
    _ -> abort "expected one delegation"

-- The ops resolver runs on the venue's node: it acts as the delegate and
-- reads as the venue (terms, prints, open prints, approved rules).
asBot : Gov -> SubmitOptions
asBot g = actAs g.bot <> readAs g.w.venue

testDelegateResolvesRoutine = script do
  (g, s1, w0, ar) <- mkGovWin
  let w = g.w
  (s2, w1) <- openWin w s1 1
  (_, w2) <- openWin w s2 2
  eth <- submit w.venue do createCmd (seriesFor w) with seriesKey = "ETH-300"; symbol = "ETH"
  (_, e0) <- openWin w eth 0
  at (plus t0 10)
  oq <- prints w t0 [px, px, px]
  -- no grant yet: the ops party cannot act as the resolver
  r0 <- trySubmit (asBot g) do
    exerciseCmd w0.terms Terms_RecordOpen with stateCid = w0.state; quoteCids = oq
  fails r0
  d <- grantDelegation g ["BTC-300"]
  -- window 0: one command per print, no vote
  Right op <- submit (asBot g) do
    exerciseCmd d Delegate_RecordOpen with termsCid = w0.terms; stateCid = w0.state; quoteCids = oq; rulesCid = ar
  -- a Series outside the grant is refused
  rEth <- trySubmit (asBot g) do
    exerciseCmd d Delegate_RecordOpen with termsCid = e0.terms; stateCid = e0.state; quoteCids = oq; rulesCid = ar
  refusedWith (refusal "not-delegated") rEth
  at (plus w0.t.expiry 10)
  cq <- prints w w0.t.expiry [px + 5, px + 5, px + 5]
  _ <- submit (asBot g) do
    exerciseCmd d Delegate_Resolve with termsCid = w0.terms; openCid = op; quoteCids = cq; rulesCid = ar
  [r] <- resolutionsOf g w0.terms
  r.outcome === Some SideUp
  -- window 1: a guardian holds it; only a guardian can
  notGuardian <- trySubmit w.venue do
    exerciseCmd d Delegation_Hold with guardian = w.venue; marketId = w1.t.marketId
  refusedWith (refusal "not-guardian") notGuardian
  d2 <- submit (asMember g g.m2) do
    exerciseCmd d Delegation_Hold with guardian = g.m2; marketId = w1.t.marketId
  at (plus w1.t.tradingStart 10)
  oq1 <- prints w w1.t.tradingStart [px, px, px]
  held <- trySubmit (asBot g) do
    exerciseCmd d2 Delegate_RecordOpen with termsCid = w1.terms; stateCid = w1.state; quoteCids = oq1; rulesCid = ar
  refusedWith (refusal "market-held") held
  -- the committee decides the held market by vote
  op1 <- govOpen g w1 ar px
  cp <- closeProposal g w1 op1 ar (px - 5) (Some SideDown)
  _ <- pass g cp
  [r1] <- resolutionsOf g w1.terms
  r1.outcome === Some SideDown
  -- revoked by vote: the delegate has nothing left to act through
  now <- getTime
  rp <- submit g.m3 do
    createCmd DelegationProposal with
      governanceParty = g.gov; proposer = g.m3; venue = w.venue; change = Revoke with delegationCid = d2
      rationale = "rotate the ops key"; expiresAt = plus now 3600
  _ <- pass g (toInterfaceContractId rp)
  at (plus w2.t.tradingStart 10)
  oq2 <- prints w w2.t.tradingStart [px, px, px]
  gone <- trySubmit (asBot g) do
    exerciseCmd d2 Delegate_RecordOpen with termsCid = w2.terms; stateCid = w2.state; quoteCids = oq2; rulesCid = ar
  fails gone
  ds <- query @ResolverDelegation g.bot
  ds === []

-- Governance-internal contracts per template, as one or more parties see them.
govCounts : [Party] -> Script [(Text, Int)]
govCounts ps = do
  a <- length <$> query @GovernanceRules ps
  b <- length <$> query @GovernanceConfirmation ps
  c <- length <$> query @GovernanceExecutionResult ps
  d <- length <$> query @ResolveMarketProposal ps
  e <- length <$> query @PolicyProposal ps
  f <- length <$> query @VenueModeProposal ps
  h <- length <$> query @DelegationProposal ps
  i <- length <$> query @ApprovedRules ps
  j <- length <$> query @VenueMode ps
  k <- length <$> query @ResolverDelegation ps
  pure [ ("GovernanceRules", a), ("GovernanceConfirmation", b), ("GovernanceExecutionResult", c)
       , ("ResolveMarketProposal", d), ("PolicyProposal", e), ("VenueModeProposal", f)
       , ("DelegationProposal", h), ("ApprovedRules", i), ("VenueMode", j), ("ResolverDelegation", k) ]

-- Members see proposals and votes through the governed party they host;
-- users (and outsiders) see nothing of governance; the venue sees only
-- what it proposed and what it must obey.
testGovernancePrivacy = script do
  (g, _, win, ar) <- mkGovWin
  let w = g.w
  op <- govOpen g win ar px
  _ <- trade w win w.alice SideUp 620 10 37 "p1"
  p <- closeProposal g win op ar (px + 5) (Some SideUp)
  _ <- confirm g g.m1 p
  _ <- grantDelegation g ["BTC-300"]
  forA_ [w.alice, w.bob, w.outsider] \u -> do
    cs <- govCounts [u]
    [(n, x) | (n, x) <- cs, x /= 0] === []
  member <- govCounts [g.m2, g.gov]
  -- rules, the pending confirmation, three executed votes (rules, open,
  -- delegation), the pending proposal, the rules, the mode, the delegation
  member === [ ("GovernanceRules", 1), ("GovernanceConfirmation", 1), ("GovernanceExecutionResult", 3)
             , ("ResolveMarketProposal", 1), ("PolicyProposal", 0), ("VenueModeProposal", 0)
             , ("DelegationProposal", 0), ("ApprovedRules", 1), ("VenueMode", 1), ("ResolverDelegation", 1) ]
  -- a member party that does not host the governed party sees only its own votes
  alone <- govCounts [g.m2]
  [(n, x) | (n, x) <- alone, x /= 0] === []
  venue <- govCounts [w.venue]
  venue === [ ("GovernanceRules", 0), ("GovernanceConfirmation", 0), ("GovernanceExecutionResult", 0)
            , ("ResolveMarketProposal", 1), ("PolicyProposal", 0), ("VenueModeProposal", 0)
            , ("DelegationProposal", 0), ("ApprovedRules", 1), ("VenueMode", 1), ("ResolverDelegation", 1) ]
