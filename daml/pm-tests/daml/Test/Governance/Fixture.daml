-- | Fixtures for governed resolution (abu-pm-governance) on BitSafe's own
-- `GovernanceRules` (governance-core-v1, vendored byte for byte).
--
-- The market's resolver IS the governed party: `World.resolver` from
-- Test.Setup plays the Decentralized Party. The committee is three member
-- parties (one per member organisation), threshold 2, confirmations valid
-- one hour; the venue is an additional proposer (may propose, never vote).
--
-- What Daml Script can and cannot show. One participant hosts everything,
-- so the governed party is an ordinary local party here. A member acts as
-- itself and reads as the governed party (`actAs m <> readAs gov`), which
-- is how each member's own node hosts the Decentralized Party (readAs
-- rights) on a network. The only submissions made AS the governed party in
-- the whole suite are the bootstrap below (GovernanceRules and the genesis
-- VenueMode), which the Decentralization Manager's contracts workflow signs
-- with k of n member keys; and, in `Test.Governance.Resolve`, the plain
-- single-key resolver path used as the settlement baseline. On a network a
-- Decentralized Party with confirmation threshold > 1 cannot submit
-- commands at all, so neither exists there.
module Test.Governance.Fixture where

import Daml.Script
import qualified DA.Set as Set
import DA.Text (isInfixOf)
import DA.Time (hours)
import Governance.Action
import Governance.Confirmation
import Governance.ExecutionResult
import Governance.Rules
import PM.Governance.Policy
import PM.Governance.Rules
import PM.Governance.Venue
import PM.Market
import PM.Oracle (PriceQuote(..))
import PM.Series
import Test.Setup

data Gov = Gov
  with
    w : World
    gov : Party
      -- ^ = w.resolver: the governed party
    m1 : Party
    m2 : Party
    m3 : Party
    o4 : Party
      -- ^ a fourth oracle, for rotations
    bot : Party
      -- ^ the ops resolver a delegation can appoint
    rules : ContractId GovernanceRules
    mode : ContractId VenueMode

-- | The world, the committee and the genesis venue mode, at t0.
mkGov : Script Gov
mkGov = do
  w <- mkWorld
  m1 <- allocateParty "member1"
  m2 <- allocateParty "member2"
  m3 <- allocateParty "member3"
  o4 <- allocateParty "oracle4"
  bot <- allocateParty "resolver-bot"
  let gov = w.resolver
  -- bootstrap (the Decentralization Manager's contracts workflow)
  rules <- submit gov do
    createCmd GovernanceRules with
      governanceParty = gov; members = Set.fromList [m1, m2, m3]; threshold = 2
      actionConfirmationTimeout = hours 1; additionalProposers = Some (Set.singleton w.venue)
  mode <- submit gov do
    createCmd VenueMode with
      governanceParty = gov; venue = w.venue; mode = ModeOpen; reason = "genesis"; since = t0; seq = 0
  pure Gov with ..

-- | A member acting as itself, reading as the governed party it hosts.
asMember : Gov -> Party -> SubmitOptions
asMember g m = actAs m <> readAs g.gov

-- | The rule set the Setup series (policy1, o1-o3, quorum 2, 50 bps) was
-- listed under.
genesisRules : Gov -> RuleSet
genesisRules g = RuleSet with
  printSource = policy1.printSource; minDelaySec = policy1.minDelaySec; barLenSec = policy1.barLenSec
  openAdmissionSec = policy1.openAdmissionSec; closeAdmissionSec = policy1.closeAdmissionSec
  oracles = [g.w.o1, g.w.o2, g.w.o3]; quorum = 2; maxDeviationBps = 50

confirm : Gov -> Party -> ContractId GovernableAction -> Script (ContractId GovernanceConfirmation)
confirm g m p = do
  r <- submit (asMember g m) do
    exerciseCmd g.rules GovernanceRules_ConfirmAction with confirmer = m; actionProposalCid = p
  pure r.confirmationCid

tryExecute : Gov -> Party -> ContractId GovernableAction -> [ContractId GovernanceConfirmation] -> Script (Either SubmitError ExecuteConfirmedActionResult)
tryExecute g m p cs = trySubmit (asMember g m) do
  exerciseCmd g.rules GovernanceRules_ExecuteConfirmedAction with
    executor = m; actionProposalCid = p; confirmations = cs

execute : Gov -> Party -> ContractId GovernableAction -> [ContractId GovernanceConfirmation] -> Script (ContractId GovernanceExecutionResult)
execute g m p cs = do
  r <- tryExecute g m p cs >>= succeeded
  pure r.executionResultCid

-- | The whole vote: m1 and m2 confirm, m3 executes.
pass : Gov -> ContractId GovernableAction -> Script (ContractId GovernanceExecutionResult)
pass g p = do
  c1 <- confirm g g.m1 p
  c2 <- confirm g g.m2 p
  execute g g.m3 p [c1, c2]

-- | The vote with m1 and m2's confirmations, returning the execution error.
passFails : Gov -> ContractId GovernableAction -> Script (Either SubmitError ExecuteConfirmedActionResult)
passFails g p = do
  c1 <- confirm g g.m1 p
  c2 <- confirm g g.m2 p
  tryExecute g g.m3 p [c1, c2]

-- | The venue proposes approving `rs` for Series `key`; the committee
-- passes it. Returns the ApprovedRules.
approveRules : Gov -> Text -> RuleSet -> Script (ContractId ApprovedRules)
approveRules g key rs = do
  now <- getTime
  p <- submit g.w.venue do
    createCmd PolicyProposal with
      governanceParty = g.gov; proposer = g.w.venue; venue = g.w.venue
      change = ApproveRules with seriesKey = key; rules = rs
      rationale = "list " <> key; expiresAt = plus now 3600
  _ <- pass g (toInterfaceContractId p)
  as <- query @ApprovedRules g.w.venue
  case [c | (c, a) <- as, a.seriesKey == key, a.rules == rs] of
    c :: _ -> pure c
    [] -> abort "approved rules not found"

-- | Governed world with the Setup series listed under approved genesis
-- rules, and window 0 open.
mkGovWin : Script (Gov, ContractId Series, Win, ContractId ApprovedRules)
mkGovWin = do
  g <- mkGov
  ar <- approveRules g "BTC-300" (genesisRules g)
  s <- mkSeries g.w
  (s1, win) <- openWin g.w s 0
  pure (g, s1, win, ar)

-- | A quote under any policy version (Setup's helper fixes version 1).
quoteV : Gov -> Party -> Time -> Int -> Int -> Script (ContractId PriceQuote)
quoteV g oracle boundary price version = submit oracle do
  createCmd PriceQuote with
    oracle; venue = g.w.venue; resolver = g.gov; symbol = "BTC"
    boundaryT = boundary; priceE8 = price; barStart = plus boundary (-60); barLenSec = 60
    fetchedAt = plus boundary 10; payloadHash = "sha256:test"; policyVersion = version

-- | Expect a failure whose text carries `msg` (BitSafe's `require` fails
-- with "The requirement '<msg>' was not met.").
failsWith : Show a => Text -> Either SubmitError a -> Script ()
failsWith msg r = case r of
  Left e | msg `isInfixOf` show e -> pure ()
  Left e -> abort ("expected '" <> msg <> "', got " <> show e)
  Right x -> abort ("expected '" <> msg <> "', but it succeeded: " <> show x)

enoughConfirmations : Text
enoughConfirmations = "Enough confirmations to execute action"

-- | Resolutions of one market.
resolutionsOf : Gov -> ContractId MarketTerms -> Script [Resolution]
resolutionsOf g terms = do
  rs <- query @Resolution g.w.venue
  pure [r | (_, r) <- rs, r.termsCid == terms]
