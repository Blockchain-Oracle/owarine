-- | Agent grants: an owner lets an agent trade within caps. The grant embeds
-- its budget (moved out of the owner's cash when it opens), so a grant never
-- exists without it; revoke returns whatever is left, expired or not.
--
-- Caps follow the reference's delegated-buy checks (`caps.ts`, golden
-- vectors `caps.vectors.json`), check for check and in its order:
--   live -> price cap (on the agent's limit, side terms) -> escrow (the
--   limit's worst charge against the budget) -> per-trade cap (actual
--   charge) -> daily cap -> budget (actual charge) -> open-position cap
--   -> the venue's fill (quote price within the limit, the reference's
--   IOC no-fill).
-- A firm quote has one price, so the reference's "limit vs fill" survives
-- as the agent's `limitTicks` against the quote's `priceTicks`.
--
-- A position is (marketId, side) and counts as open until its market's
-- `refundAfter` (by which every leg is settled or refundable); the grant
-- never sees settles, so this is the conservative reading of the
-- reference's decrement-on-settle.
module PM.Grant where

import DA.Assert (assertDeadlineExceeded, assertWithinDeadline)
import DA.Time (addRelTime, convertRelTimeToMicroseconds, days, seconds, subTime)
import PM.Leg
import PM.Money
import PM.Quote
import PM.Types

data GrantCaps = GrantCaps
  with
    maxStakePerTrade : Int
    maxDailySpend : Int
    maxPriceTicks : Int
      -- ^ side terms, 0 = off
    maxOpenPositions : Int
  deriving (Eq, Show)

data GrantPosition = GrantPosition
  with
    marketId : Text
    outcome : Side
    refundAfter : Time
  deriving (Eq, Show)

-- | Everything a cap check reads, in the reference's terms.
data CapInput = CapInput
  with
    caps : GrantCaps
    budget : Int
    spentToday : Int
      -- ^ already reset to 0 on a new day
    openPositions : Int
      -- ^ still-open positions, pruned at asOf
    opensNewPosition : Bool
    limitTicks : Int
    priceTicks : Int
    lots : Int
    cashUnit : Int
    fee : Int
  deriving (Eq, Show)

-- | The first refusal in the reference's order, or None. Pure, so a
-- client can pre-check with the same code (codegen exposes the data only).
capRefusal : CapInput -> Optional (Text, Text)
capRefusal i
  | i.caps.maxPriceTicks /= 0 && i.limitTicks > i.caps.maxPriceTicks =
      Some ("over-price-cap", "price exceeds the grant's price cap")
  | worst > i.budget = Some ("insufficient-budget", "grant budget does not cover the escrow at the limit")
  | charge > i.caps.maxStakePerTrade = Some ("over-stake-cap", "charge exceeds the per-trade cap")
  | i.spentToday + charge > i.caps.maxDailySpend = Some ("over-daily-cap", "charge exceeds today's remaining spend")
  | charge > i.budget = Some ("insufficient-budget", "grant budget does not cover the charge")
  | i.opensNewPosition && i.openPositions + 1 > i.caps.maxOpenPositions =
      Some ("over-position-cap", "a new position exceeds the open-position cap")
  | i.priceTicks > i.limitTicks = Some ("no-fill", "the quote is above the agent's limit")
  | otherwise = None
  where
    charge = userStakeOf i.lots i.priceTicks i.cashUnit + i.fee
    worst = userStakeOf i.lots i.limitTicks i.cashUnit + i.fee

-- | Day index of `t` counted from `dayZero` (t >= dayZero).
dayIndex : Time -> Time -> Int
dayIndex dayZero t =
  convertRelTimeToMicroseconds (subTime t dayZero) / convertRelTimeToMicroseconds (days 1)

-- | The venue's standing offer to open grants for one owner. The owner opens
-- a grant from their own cash; the venue's signature here supplies the
-- venue half of the authority the new grant needs.
template GrantOffer
  with
    venue : Party
    owner : Party
  where
    signatory venue
    observer owner

    nonconsuming choice GrantOffer_Open : ContractId AgentGrant
      with
        agent : Party
        caps : GrantCaps
        expiresAt : Time
        dayZero : Time
        budget : Int
        cash : [ContractId VenueCash]
      controller owner
      do
        total <- sumOwnedCash venue owner cash
        require "insufficient-cash" "cash does not cover the budget" (total >= budget)
        _ <- payIfPositive venue owner (total - budget) "change"
        create AgentGrant with
          venue; owner; agent; caps; budget; expiresAt; dayZero; day = 0; spentToday = 0
          positions = []

template AgentGrant
  with
    venue : Party
    owner : Party
    agent : Party
    caps : GrantCaps
    budget : Int
    expiresAt : Time
    dayZero : Time
      -- ^ start of day 0; day d is [dayZero + d days, dayZero + (d+1) days)
    day : Int
    spentToday : Int
    positions : [GrantPosition]
      -- ^ open positions opened under this grant (pruned lazily)
  where
    signatory owner, venue
    observer agent
    ensure budget >= 0 && day >= 0 && spentToday >= 0
      && caps.maxStakePerTrade > 0 && caps.maxDailySpend > 0
      && caps.maxPriceTicks >= 0 && caps.maxPriceTicks <= 999 && caps.maxOpenPositions > 0
      && agent /= owner && agent /= venue

    -- The agent accepts one of the owner's quotes at or under its limit.
    -- `asOf` is the agent's clock, pinned by ledger-time assertions (ledger
    -- time is in [asOf, end of asOf's day)), so no getTime: it picks the
    -- cap day and prunes positions whose market is past refundAfter.
    choice Grant_AcceptQuote : (ContractId AgentGrant, ContractId Leg)
      with
        quoteCid : ContractId Quote
        limitTicks : Int
        asOf : Time
      controller agent
      do
        -- the reference refuses only when now > expiresAt, so admit at it
        assertWithinDeadline "grant-expiry" (addRelTime expiresAt (seconds 1))
        require "before-day-zero" "asOf precedes the grant's day zero" (asOf >= dayZero)
        let today = dayIndex dayZero asOf
        assertDeadlineExceeded "grant-as-of" asOf
        assertWithinDeadline "grant-day-end" (addRelTime dayZero (days (today + 1)))
        require "stale-day" "day cannot go backwards" (today >= day)
        require "bad-grid" "limit must be 1..999" (ticksOk limitTicks)
        q <- fetch quoteCid
        require "wrong-quote" "quote is not for this grant's owner" (q.user == owner && q.venue == venue)
        let spent = if today > day then 0 else spentToday
            live = filter (\p -> p.refundAfter > asOf) positions
            opensNew = not (any (\p -> p.marketId == q.marketId && p.outcome == q.side) live)
            charge = userStakeOf q.lots q.priceTicks q.cashUnit + q.fee
        case capRefusal CapInput with
              caps; budget; spentToday = spent; openPositions = length live
              opensNewPosition = opensNew; limitTicks; priceTicks = q.priceTicks
              lots = q.lots; cashUnit = q.cashUnit; fee = q.fee of
          Some (code, msg) -> refuse code msg
          None -> pure ()
        fund <- create VenueCash with venue; owner; amount = charge; bucket = "grant"
        (leg, _venueLeg, _change) <- exercise quoteCid Quote_Accept with
          cash = [fund]; beneficiaryRef = Some "grant"
        let positions' = if opensNew
              then live ++ [GrantPosition with marketId = q.marketId; outcome = q.side; refundAfter = q.refundAfter]
              else live
        g <- create this with
          budget = budget - charge; day = today; spentToday = spent + charge; positions = positions'
        pure (g, leg)

    choice Grant_Revoke : Optional (ContractId VenueCash)
      controller owner
      do payIfPositive venue owner budget "grant-return"
