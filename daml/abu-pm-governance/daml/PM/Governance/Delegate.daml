-- | Routine resolution without a vote per Window.
--
-- A party whose confirmation threshold is above 1 cannot submit ordinary
-- Ledger API commands, so once the resolver is a Decentralized Party the
-- ops resolver cannot act as it. For price Windows (every few minutes) a
-- vote per print would stall the product, so the committee votes once to
-- appoint a delegate: `ResolverDelegation`, signed by the governed party,
-- lets one ops party run the engine's price-window choices for the listed
-- Series, and nothing else:
--   * a resolve or open print still needs the Window listed under approved
--     rules, and the engine's quorum, deviation and deadline checks bound
--     what the delegate can produce;
--   * events (judgement markets) are never delegated: only a vote
--     resolves them (PM.Governance.Resolve);
--   * any single guardian (a committee member at grant time) can hold a
--     market, taking it away from the delegate at once; the committee then
--     resolves or voids it by vote. Holding only ever moves a market to the
--     slower, governed path, so one member can delay a payout, never make
--     one;
--   * the committee revokes or replaces the delegation by vote.
-- This is BitSafe's "Governance applies only to the actions selected by
-- the application": the vote governs who may resolve, the hot path stays
-- a single command.
module PM.Governance.Delegate where

import DA.List (unique)
import Governance.Action
import PM.Governance.Rules
import PM.Market
import PM.Oracle (PriceQuote)
import PM.Types

template ResolverDelegation
  with
    governanceParty : Party
    venue : Party
    delegate : Party
    guardians : [Party]
    seriesKeys : [Text]
    held : [Text]
      -- ^ market ids taken back for the committee
    grantedAt : Time
  where
    signatory governanceParty
    observer venue, delegate
      -- guardians read it through the governed party (readAs hosting)
    ensure not (null guardians) && unique guardians
      && not (null seriesKeys) && unique seriesKeys && notElem "" seriesKeys

    nonconsuming choice Delegate_RecordOpen : Either (ContractId Resolution) (ContractId OpenPrint)
      with
        termsCid : ContractId MarketTerms
        stateCid : ContractId WindowState
        quoteCids : [ContractId PriceQuote]
        rulesCid : ContractId ApprovedRules
      controller delegate
      do
        t <- delegated this termsCid
        checkListed governanceParty rulesCid t
        exercise termsCid Terms_RecordOpen with stateCid; quoteCids

    nonconsuming choice Delegate_Resolve : ContractId Resolution
      with
        termsCid : ContractId MarketTerms
        openCid : ContractId OpenPrint
        quoteCids : [ContractId PriceQuote]
        rulesCid : ContractId ApprovedRules
      controller delegate
      do
        t <- delegated this termsCid
        checkListed governanceParty rulesCid t
        exercise termsCid Terms_Resolve with openCid; quoteCids

    nonconsuming choice Delegate_Void : ContractId Resolution
      with
        termsCid : ContractId MarketTerms
        stage : VoidStage
        quoteCids : [ContractId PriceQuote]
      controller delegate
      do
        _ <- delegated this termsCid
        exercise termsCid Terms_Void with stage; quoteCids

    choice Delegation_Hold : ContractId ResolverDelegation
      with
        guardian : Party
        marketId : Text
      controller guardian
      do
        require "not-guardian" "only a guardian of this delegation can hold a market" (guardian `elem` guardians)
        require "already-held" "the market is already held" (marketId `notElem` held)
        create this with held = marketId :: held

-- | The terms must be the venue's, resolved by the governed party, on a
-- delegated Series, and not held.
delegated : ResolverDelegation -> ContractId MarketTerms -> Update MarketTerms
delegated d termsCid = do
  t <- fetch termsCid
  require "not-delegated" "the delegation does not cover this market"
    (t.venue == d.venue && t.resolver == d.governanceParty && t.seriesKey `elem` d.seriesKeys)
  require "market-held" "a guardian holds this market for the committee" (t.marketId `notElem` d.held)
  pure t

data DelegationChange
  = Grant with
      delegate : Party
      guardians : [Party]
      seriesKeys : [Text]
  | Revoke with
      delegationCid : ContractId ResolverDelegation
  deriving (Eq, Show)

template DelegationProposal
  with
    governanceParty : Party
    proposer : Party
    venue : Party
    change : DelegationChange
    rationale : Text
    expiresAt : Time
  where
    signatory proposer
    observer governanceParty
    ensure rationale /= ""

    interface instance GovernableAction for DelegationProposal where
      view = GovernableActionView with
        governanceParty; proposer
        actionLabel = case change of
          Grant {} -> "GrantResolverDelegation"
          Revoke {} -> "RevokeResolverDelegation"
        description = case change of
          Grant d _ keys -> "Delegate price-window resolution of " <> show keys <> " to " <> show d <> ": " <> rationale
          Revoke cid -> "Revoke delegation " <> show cid <> ": " <> rationale
      executeImpl = do
        checkFresh expiresAt
        case change of
          Grant delegate guardians seriesKeys -> do
            grantedAt <- getTime
            _ <- create ResolverDelegation with
              governanceParty; venue; delegate; guardians; seriesKeys; held = []; grantedAt
            pure ()
          Revoke cid -> do
            d <- fetch cid
            require "wrong-delegation" "the delegation belongs to another resolver or venue"
              (d.governanceParty == governanceParty && d.venue == venue)
            archive cid
