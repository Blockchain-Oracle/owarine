-- | The venue's trading mode (the reference's `admin_set_mode`: open,
-- reduce-only, paused), held by the governed party.
--
-- `VenueMode` is signed by the governed party alone, so the venue can read
-- it but can neither create, archive nor replace it: only a vote moves it.
-- The issuer policy (parity C-DAML-02; not yet wired in ops) reads the
-- live mode before every quote and issues nothing new while it is Paused,
-- nothing that adds exposure while ReduceOnly. User exits never check it,
-- so a pause can stop new risk but can never trap a user's position.
--
-- The engine's `Desk_IssueQuote` does not read `VenueMode` (abu-pm-main
-- 0.5.0 unchanged), so the pause binds the venue's software, not the
-- ledger: a venue that ignored it would leave every quote it issued after
-- the mode's `since` on the ledger, dated, for the auditor to show.
--
-- The genesis mode is deployed with `GovernanceRules` (the Decentralization
-- Manager's contracts workflow signs both with the governed party); every
-- later mode comes from a `VenueModeProposal` naming the live one, so two
-- votes racing on the same mode cannot both execute.
module PM.Governance.Venue where

import Governance.Action
import PM.Governance.Rules (checkFresh)
import PM.Types

data Mode = ModeOpen | ModeReduceOnly | ModePaused
  deriving (Eq, Show)

template VenueMode
  with
    governanceParty : Party
    venue : Party
    mode : Mode
    reason : Text
    since : Time
    seq : Int
      -- ^ 0 for the genesis mode, +1 per executed change
  where
    signatory governanceParty
    observer venue
    ensure reason /= "" && seq >= 0

template VenueModeProposal
  with
    governanceParty : Party
    proposer : Party
    venue : Party
    current : ContractId VenueMode
    mode : Mode
    reason : Text
    expiresAt : Time
  where
    signatory proposer
    observer governanceParty
    ensure reason /= ""

    interface instance GovernableAction for VenueModeProposal where
      view = GovernableActionView with
        governanceParty; proposer
        actionLabel = "SetVenueMode"
        description = "Venue mode -> " <> show mode <> ": " <> reason
      executeImpl = do
        checkFresh expiresAt
        m <- fetch current
        require "wrong-venue" "the mode belongs to another venue or resolver"
          (m.venue == venue && m.governanceParty == governanceParty)
        require "mode-unchanged" "the venue is already in this mode" (m.mode /= mode)
        archive current
        since <- getTime
        _ <- create VenueMode with governanceParty; venue; mode; reason; since; seq = m.seq + 1
        pure ()
