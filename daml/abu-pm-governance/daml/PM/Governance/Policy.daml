-- | Governed oracle-set and policy rotation for a Series.
--
-- A vote approves a rule set (policy content plus oracle set, quorum and
-- deviation limit) for one Series, or retires one. Execution creates or
-- archives the `ApprovedRules` (PM.Governance.Rules); the venue then puts
-- approved rules on its Series with `Rules_Apply`, which runs the engine's
-- `Series_AddPolicyVersion`, so the rotation arrives as a new policy
-- version from the next unopened Window and no listed Window changes.
--
-- Retiring rules stops the governed resolver from resolving any Window
-- still listed under them; those Windows can only be voided. Retire only
-- rules no open Window uses, or accept those voids.
module PM.Governance.Policy where

import Governance.Action
import PM.Governance.Rules
import PM.Types

data PolicyChange
  = ApproveRules with
      seriesKey : Text
      rules : RuleSet
  | RetireRules with
      rulesCid : ContractId ApprovedRules
  deriving (Eq, Show)

template PolicyProposal
  with
    governanceParty : Party
    proposer : Party
    venue : Party
    change : PolicyChange
    rationale : Text
    expiresAt : Time
  where
    signatory proposer
    observer governanceParty
    ensure rationale /= "" && changeOk change

    interface instance GovernableAction for PolicyProposal where
      view = GovernableActionView with
        governanceParty; proposer
        actionLabel = case change of
          ApproveRules {} -> "ApproveResolutionRules"
          RetireRules {} -> "RetireResolutionRules"
        description = case change of
          ApproveRules key r ->
            "Series " <> key <> " resolves under " <> r.printSource <> ", "
              <> committeeText r <> ": " <> rationale
          RetireRules cid -> "Retire rules " <> show cid <> ": " <> rationale
      executeImpl = executePolicy this

changeOk : PolicyChange -> Bool
changeOk c = case c of
  ApproveRules key r -> key /= "" && ruleSetOk r
  RetireRules _ -> True

executePolicy : PolicyProposal -> Update ()
executePolicy p = do
  checkFresh p.expiresAt
  case p.change of
    ApproveRules seriesKey rules -> do
      approvedAt <- getTime
      _ <- create ApprovedRules with
        governanceParty = p.governanceParty; venue = p.venue; seriesKey; rules; approvedAt
      pure ()
    RetireRules rulesCid -> do
      a <- fetch rulesCid
      require "wrong-rules" "these rules belong to another resolver or venue"
        (a.governanceParty == p.governanceParty && a.venue == p.venue)
      archive rulesCid
