-- | The resolution rules a governed resolver will resolve under (K-150).
--
-- The market's `resolver` is the governed party: on a network, a BitSafe
-- Decentralized Party whose committee acts through the Decentralization
-- Manager's `GovernanceRules` (members confirm, any member executes once
-- the threshold is met). In Daml alone the same party is an ordinary
-- party that only the governance engine exercises for (PM.Governance.*).
--
-- `ApprovedRules` is what the committee voted for a Series: the price
-- policy's content and the oracle set, quorum and deviation limit that
-- `Series` copies into every `MarketTerms` at open. The governed resolver
-- (a vote, or the delegate a vote appointed) resolves a Window only when
-- its frozen terms match a live `ApprovedRules` of the same Series. The
-- venue still owns its Series and can change it alone, but a Window listed
-- under rules nobody approved can only be voided (every user refunded),
-- never paid out. Voids never need approval.
--
-- Approval is by content, not by Series contract id, because the roller
-- consumes the Series every Window: a vote that pinned a Series id would be
-- stale before it executed (the framework's "UTXO drift"). The venue
-- applies approved rules with `Rules_Apply`, which runs the engine's own
-- `Series_AddPolicyVersion` (append-only, never covering an opened Window)
-- and then sets the oracle fields, in one transaction.
module PM.Governance.Rules where

import DA.List (last, sort, unique)
import DA.Time (addRelTime, seconds)
import PM.Market (MarketTerms(..), closeAdmissionOf)
import PM.Series (Series(..), Series_AddPolicyVersion(..), openFloor)
import PM.Types

-- | One approved rule set: the policy content (no version number or date,
-- which the venue's Series assigns when it applies it) and the committee.
data RuleSet = RuleSet
  with
    printSource : Text
    minDelaySec : Int
    barLenSec : Int
    openAdmissionSec : Int
      -- ^ negative = admit the open print until lockAt (as `PolicyVersion`)
    closeAdmissionSec : Int
    oracles : [Party]
    quorum : Int
    maxDeviationBps : Int
  deriving (Eq, Show)

ruleSetOk : RuleSet -> Bool
ruleSetOk r =
  r.printSource /= "" && r.minDelaySec >= 0 && r.barLenSec > 0 && r.closeAdmissionSec >= 0
    && r.quorum >= 1 && r.quorum <= length r.oracles && unique r.oracles
    && r.maxDeviationBps >= 0

-- | Whether a Window's frozen terms were listed under this rule set (the
-- oracle list compared as a set: `Series` keeps its own order).
listedUnder : RuleSet -> MarketTerms -> Bool
listedUnder r t =
  t.printSource == r.printSource && t.minDelaySec == r.minDelaySec
    && t.barLenSec == r.barLenSec
    && closeAdmissionOf t == seconds r.closeAdmissionSec
    && t.openDeadline == openDeadlineUnder r t
    && sort t.oracles == sort r.oracles && t.quorum == r.quorum
    && t.maxDeviationBps == r.maxDeviationBps

openDeadlineUnder : RuleSet -> MarketTerms -> Time
openDeadlineUnder r t =
  if r.openAdmissionSec < 0 then t.lockAt
  else addRelTime t.tradingStart (seconds r.openAdmissionSec)

-- | Short text for audit records: "3 oracles, quorum 2, 50 bps".
committeeText : RuleSet -> Text
committeeText r =
  show (length r.oracles) <> " oracles, quorum " <> show r.quorum
    <> ", " <> show r.maxDeviationBps <> " bps"

template ApprovedRules
  with
    governanceParty : Party
    venue : Party
    seriesKey : Text
    rules : RuleSet
    approvedAt : Time
  where
    signatory governanceParty
    observer venue
    ensure seriesKey /= "" && ruleSetOk rules

    -- The venue applies these rules to its own Series: the engine appends
    -- the next policy version from the Series' next unopened Window (its
    -- own checks: next number, later date, never covering an opened
    -- Window), then the oracle set, quorum and deviation limit are set.
    -- Every Window opened afterwards is listed under these rules.
    nonconsuming choice Rules_Apply : ContractId Series
      with
        seriesCid : ContractId Series
      controller venue
      do
        s <- fetch seriesCid
        require "wrong-series" "the Series is not the one these rules were approved for"
          (s.seriesKey == seriesKey && s.venue == venue && s.resolver == governanceParty)
        let prev = last s.policyVersions
            pv = PolicyVersion with
              version = prev.version + 1; effectiveFrom = openFloor s; validUntil = None
              printSource = rules.printSource; minDelaySec = rules.minDelaySec
              barLenSec = rules.barLenSec; openAdmissionSec = rules.openAdmissionSec
              closeAdmissionSec = rules.closeAdmissionSec
        appended <- exercise seriesCid Series_AddPolicyVersion with pv
        s' <- fetch appended
        archive appended
        create s' with
          oracles = rules.oracles; quorum = rules.quorum; maxDeviationBps = rules.maxDeviationBps

-- | Refuse unless `rulesCid` is live approved rules of this governed party
-- and venue, for the terms' Series, and the terms were listed under them.
checkListed : Party -> ContractId ApprovedRules -> MarketTerms -> Update ()
checkListed governanceParty rulesCid t = do
  a <- fetch rulesCid
  require "rules-not-approved" "these rules are not approved by this resolver for this venue and Series"
    (a.governanceParty == governanceParty && a.venue == t.venue && a.seriesKey == t.seriesKey)
  require "rules-not-approved" "the Window was not listed under the approved rules"
    (listedUnder a.rules t)

-- | Every governed proposal carries a hard expiry: a vote that has not
-- executed by then is stale, and only its proposer or the committee can
-- clear it. (Each confirmation also expires, after the committee's
-- `actionConfirmationTimeout`; that is `GovernanceRules`' own check.)
checkFresh : Time -> Update ()
checkFresh expiresAt = do
  now <- getTime
  require "proposal-expired" "the proposal expired before it executed" (now <= expiresAt)
