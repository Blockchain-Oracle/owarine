-- | Governed resolution: a disputed (or any) market is resolved or voided
-- by the committee, through the engine's own resolver choices.
--
--   proposer (a member, or the venue as an additional proposer)
--     creates ResolveMarketProposal            (signatory proposer only)
--   members  GovernanceRules_ConfirmAction      (one GovernanceConfirmation each)
--   a member GovernanceRules_ExecuteConfirmedAction
--              -> GovernableAction_Execute      (the governed party's authority)
--              -> Terms_RecordOpen / Terms_Resolve / Terms_Void
--                 / Event_Resolve / Event_Void  (PM.Market, PM.Event, unchanged)
--              -> GovernanceExecutionResult     (label, description, confirmers)
--
-- `GovernanceRules` and the confirmations are BitSafe's released
-- `governance-core-v1` (the Decentralization Manager deploys it); this
-- module only implements its `GovernableAction` interface. Nothing here
-- changes what a resolution is: the engine checks quorum, deviation,
-- deadlines and single use exactly as for a plain resolver, and the
-- `Resolution` it creates is the one Legs settle against.
--
-- What the vote adds on top of the engine:
--   * the committee votes on an outcome, not a blank cheque: a resolve
--     names the expected outcome (a side, or None = void on disagreement)
--     and fails if the evidence produces anything else;
--   * a resolve (or an open print) needs the Window listed under rules the
--     committee approved (PM.Governance.Rules); a void never does;
--   * the proposal is bound to one market (`marketId`, venue, resolver)
--     and expires at `expiresAt`.
module PM.Governance.Resolve where

import Governance.Action
import PM.Event
import PM.Governance.Rules
import PM.Market
import PM.Oracle (PriceQuote)
import PM.Types

data ResolveAction
  = RecordOpen with
      termsCid : ContractId MarketTerms
      stateCid : ContractId WindowState
      quoteCids : [ContractId PriceQuote]
      rulesCid : ContractId ApprovedRules
  | ResolvePrice with
      termsCid : ContractId MarketTerms
      openCid : ContractId OpenPrint
      quoteCids : [ContractId PriceQuote]
      rulesCid : ContractId ApprovedRules
      expected : Optional Side
        -- ^ the outcome the committee confirms; None = void on disagreement
  | VoidPrice with
      termsCid : ContractId MarketTerms
      stage : VoidStage
      quoteCids : [ContractId PriceQuote]
        -- ^ only name the reason (possibly none)
  | ResolveEvent with
      eventCid : ContractId EventTerms
      eventStateCid : ContractId EventState
      attestationCids : [ContractId EventAttestation]
      rulesCid : ContractId ApprovedRules
      expected : Optional Side
  | VoidEvent with
      eventCid : ContractId EventTerms
      eventStateCid : ContractId EventState
      attestationCids : [ContractId EventAttestation]
  deriving (Eq, Show)

-- | The audit grouping key (PascalCase, never recycled).
labelOf : ResolveAction -> Text
labelOf a = case a of
  RecordOpen {} -> "RecordOpenPrint"
  ResolvePrice {} -> "ResolveMarket"
  ResolveEvent {} -> "ResolveMarket"
  VoidPrice {} -> "VoidMarket"
  VoidEvent {} -> "VoidMarket"

outcomeText : Optional Side -> Text
outcomeText o = case o of
  Some SideUp -> "UP/YES"
  Some SideDown -> "DOWN/NO"
  None -> "VOID"

template ResolveMarketProposal
  with
    governanceParty : Party
      -- ^ the market's resolver: the governed party
    proposer : Party
    venue : Party
    marketId : Text
    action : ResolveAction
    rationale : Text
      -- ^ copied into the permanent GovernanceExecutionResult
    expiresAt : Time
  where
    signatory proposer
    observer governanceParty
    ensure marketId /= "" && rationale /= ""

    interface instance GovernableAction for ResolveMarketProposal where
      view = GovernableActionView with
        governanceParty; proposer
        actionLabel = labelOf action
        description = describe this
      executeImpl = executeResolution this

describe : ResolveMarketProposal -> Text
describe p =
  let what = case p.action of
        RecordOpen {} -> "records the open print"
        ResolvePrice _ _ _ _ e -> "resolves " <> outcomeText e
        ResolveEvent _ _ _ _ e -> "resolves " <> outcomeText e
        VoidPrice {} -> "voids"
        VoidEvent {} -> "voids"
  in "Market " <> p.marketId <> " " <> what <> ": " <> p.rationale

executeResolution : ResolveMarketProposal -> Update ()
executeResolution p = do
  checkFresh p.expiresAt
  case p.action of
    RecordOpen termsCid stateCid quoteCids rulesCid -> do
      t <- boundTerms p termsCid
      checkListed p.governanceParty rulesCid t
      _ <- exercise termsCid Terms_RecordOpen with stateCid; quoteCids
      pure ()
    ResolvePrice termsCid openCid quoteCids rulesCid expected -> do
      t <- boundTerms p termsCid
      checkListed p.governanceParty rulesCid t
      res <- exercise termsCid Terms_Resolve with openCid; quoteCids
      checkOutcome expected res
    VoidPrice termsCid stage quoteCids -> do
      _ <- boundTerms p termsCid
      _ <- exercise termsCid Terms_Void with stage; quoteCids
      pure ()
    ResolveEvent eventCid eventStateCid attestationCids rulesCid expected -> do
      e <- fetch eventCid
      t <- boundTerms p e.termsCid
      checkListed p.governanceParty rulesCid t
      (res, _) <- exercise eventCid Event_Resolve with stateCid = eventStateCid; attestationCids
      checkOutcome expected res
    VoidEvent eventCid eventStateCid attestationCids -> do
      e <- fetch eventCid
      _ <- boundTerms p e.termsCid
      _ <- exercise eventCid Event_Void with stateCid = eventStateCid; attestationCids
      pure ()

-- | The terms must be the proposal's market, of its venue, resolved by the
-- governed party.
boundTerms : ResolveMarketProposal -> ContractId MarketTerms -> Update MarketTerms
boundTerms p termsCid = do
  t <- fetch termsCid
  require "wrong-market" "the proposal names another market, venue or resolver"
    (t.marketId == p.marketId && t.venue == p.venue && t.resolver == p.governanceParty)
  pure t

-- | What the evidence produced must be what the committee voted for.
checkOutcome : Optional Side -> ContractId Resolution -> Update ()
checkOutcome expected resCid = do
  r <- fetch resCid
  require "outcome-mismatch" "the evidence resolves differently from the outcome the committee confirmed"
    (r.outcome == expected)
