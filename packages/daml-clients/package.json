{
  "name": "@owarine/daml",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "TypeScript bindings for the abu-pm-main, abu-pm-tickets, abu-pm-games, abu-pm-agents and abu-pm-cc Daml packages (dpm codegen-js output in generated/, regenerated by `pnpm codegen:daml`).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@daml.js/abu-pm-agents": "link:./generated/abu-pm-agents",
    "@daml.js/abu-pm-cc": "link:./generated/abu-pm-cc",
    "@daml.js/abu-pm-games": "link:./generated/abu-pm-games",
    "@daml.js/abu-pm-main": "link:./generated/abu-pm-main",
    "@daml.js/abu-pm-main-0.5.2": "link:./generated/abu-pm-main",
    "@daml.js/abu-pm-tickets": "link:./generated/abu-pm-tickets",
    "@daml.js/daml-prim-DA-Types-1.0.0": "link:./generated/daml-prim-DA-Types-1.0.0",
    "@daml.js/daml-stdlib-DA-Time-Types-1.0.0": "link:./generated/daml-stdlib-DA-Time-Types-1.0.0",
    "@daml.js/ghc-stdlib-DA-Internal-Template-1.0.0": "link:./generated/ghc-stdlib-DA-Internal-Template-1.0.0",
    "@daml.js/splice-api-token-holding-v1-1.0.0": "link:./generated/splice-api-token-holding-v1-1.0.0",
    "@daml.js/splice-api-token-metadata-v1-1.0.0": "link:./generated/splice-api-token-metadata-v1-1.0.0",
    "@daml.js/splice-api-token-transfer-instruction-v1-1.0.0": "link:./generated/splice-api-token-transfer-instruction-v1-1.0.0",
    "@daml/types": "3.5.2",
    "@mojotech/json-type-validation": "3.1.0"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
