{
  "name": "@agari/daml",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "TypeScript bindings for the abu-pm-main and abu-pm-tickets Daml packages (dpm codegen-js output in generated/, regenerated by `pnpm codegen:daml`).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@daml.js/abu-pm-main": "link:./generated/abu-pm-main",
    "@daml.js/abu-pm-main-0.4.0": "link:./generated/abu-pm-main",
    "@daml.js/abu-pm-tickets": "link:./generated/abu-pm-tickets",
    "@daml.js/daml-prim-DA-Types-1.0.0": "link:./generated/daml-prim-DA-Types-1.0.0",
    "@daml.js/ghc-stdlib-DA-Internal-Template-1.0.0": "link:./generated/ghc-stdlib-DA-Internal-Template-1.0.0",
    "@daml/types": "3.5.2",
    "@mojotech/json-type-validation": "3.1.0"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
