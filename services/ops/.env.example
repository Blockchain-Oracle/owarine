# Ops environment: NAMES ONLY. Copy to services/ops/.env.local locally (gitignored; ops loads it first, explicit env
# wins); on Coolify set each in the ops app's Environment Variables (docs/plan/runbooks/coolify-deploy.md).
# One container only, ever (AD-4): every actor is a single writer. Defaults are in the comments.

# --- Required -----------------------------------------------------------------------------------------------------------
DATABASE_URL=                       # the same Postgres as the web
DRY_RUN=                            # 0 to act; anything else (or unset) = plan and log, never submit
OPS_INTERNAL_SECRET=                # >= 32 chars; the same value in the web
AGARI_PARTIES_FILE=                 # parties.json from the bootstrap (Coolify file mount, e.g. /data/parties.json);
#                                   local default ~/.config/agari/canton/parties.json
# VENUE_PARTY=                      # overrides the file's venue (the projector's party)

# --- Ledger (packages/ledger) --------------------------------------------------------------------------------------------
LEDGER_JSON_API_URL=
LEDGER_AUTH_MODE=                   # none (local sandbox) | password (Noders, K-035)
# LEDGER_USER_ID=
# LEDGER_OIDC_TOKEN_URL=
# LEDGER_OIDC_CLIENT_ID=
# LEDGER_OIDC_USERNAME=
# LEDGER_OIDC_PASSWORD=
# LEDGER_OIDC_SCOPE=
# LEDGER_OIDC_AUDIENCE=

# --- Reaching the web (the room describes a dealt deck through the web's routes; C9c/C9d) ----------------------------
# AGARI_WEB_ORIGIN=                 # the web as ops reaches it, e.g. http://<web-container>:3000; else the next two
NEXT_PUBLIC_APP_ORIGIN=             # https://<domain>
# NEXT_PUBLIC_SITE_URL=
# NEXT_PUBLIC_AGARI_INDEXER_URL=    # absolute wins; relative or unset resolves against the origin above (C10a),
#                                   finally http://127.0.0.1:3000/api/index
# NEXT_PUBLIC_CANTON_NETWORK=       # default devnet

# --- Listeners (set by the Dockerfile) -----------------------------------------------------------------------------------
# OPS_HTTP_PORT=                    # 8080 in the image (/health, SSE, /internal/*); default PORT, then 8787
# GAME_ROOM_HOST=                   # 0.0.0.0 in the image; default 127.0.0.1
# GAME_ROOM_PORT=                   # 8787
# GAME_DECK_JOURNAL=                # /data/deck-journal.jsonl in the image
# OPS_ACTORS=                       # default: the venue set

# --- Price sources (lanes pause, naming the missing source, without them) --------------------------------------------
ALPACA_ENDPOINT=                    # https://paper-api.alpaca.markets/v2
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
FINNHUB_API_KEY=
# ALPACA_DATA_ENDPOINT=
# PYTH_API_KEY=                     # valuation lanes need one entitled to pyth-indices (D-125)
# JUPITER_API_KEY=
# REDSTONE_GATEWAY_URLS=

# --- Games, push, agents, X (optional features) --------------------------------------------------------------------------
ROOM_TOKEN_SECRET=                  # >= 16 chars; the same value in the web
GAME_DECK_KEY=
# GAME_ROOM_REGION=
# PUSH_DRAIN_URL=                   # https://<domain>/api/push/drain
# PUSH_DRAIN_SECRET=                # the same value in the web
# OPENAI_API_KEY=
# AI_MODEL=
# X_HANDLE=
# X_RETTIWT_API_KEY=
# X_EXECUTOR_PARTY=
# X_POSTING_ENABLED=

# --- Venue tuning (defaults are the gate-tested values) ------------------------------------------------------------------
# SEAT_FUND_CREDITS=
# SEAT_CREDIT_MAX_CREDITS=
# SETTLE_BATCH=
# MM_SIGMA_BPS=
# VOL_EVERY_MIN=
# VOL_WINDOW_MIN=
# ROLLER_LEAD_SEC=
# ROLLER_GAP_LEAD_SEC=
# PROJECTOR_STREAM=                 # default venue; must match the web
# OPS_EVENTS_FILE=
